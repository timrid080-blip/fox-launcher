{
  "name": "fox-launcher",
  "productName": "Fox Launcher",
  "version": "3.1.0",
  "description": "Fox Launcher — современный лаунчер Minecraft",
  "main": "main.js",
  "author": "FoxBro",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "dist:dir": "electron-builder --win dir",
    "test": "node --check main.js && node --check renderer/app.js && node --check core/cloud.js && node --check core/official-mods.js && node --test tests/core.test.cjs tests/club-sql.test.cjs tests/v130.test.cjs tests/v140.test.cjs tests/payments.test.cjs tests/v150.test.cjs tests/news-updater.test.cjs tests/network.test.cjs tests/v160.test.cjs tests/v170.test.cjs tests/updater-config.test.cjs tests/codes-v190.test.cjs tests/autoupdate-release-config.test.cjs tests/startup-overlay.test.cjs tests/social-features.test.cjs tests/launcher-modes.test.cjs tests/official-mods.test.cjs",
    "dist:portable": "electron-builder --win portable",
    "test:sql": "node --test tests/club-sql.test.cjs",
    "dist:update": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.foxbro.foxlauncher",
    "productName": "Fox Launcher",
    "icon": "assets/icon.ico",
    "files": [
      "main.js",
      "preload.js",
      "core/**",
      "renderer/**",
      "assets/**",
      "package.json",
      "fox-news.json",
      "fox-services.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Fox Launcher",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "FoxLauncher-Portable-${version}.exe",
      "useZip": true
    },
    "compression": "normal",
    "publish": [
      {
        "provider": "github",
        "owner": "timrid080-blip",
        "repo": "fox-launcher",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/timrid080-blip/fox-launcher.git"
  }
}
